// ============================================================================
// Kelmon Fashion — database schema
//
// Prisma owns the schema and the migrations, and nothing else. `prisma migrate`
// is how the database changes shape; every read and write at runtime goes
// through supabase-js.
//
// That boundary is a security decision, not a style one. Prisma connects
// straight to Postgres over a connection string, so it runs as the database
// owner and Row Level Security does not apply to it — `app_uid()` returns null
// for every Prisma query. The Supabase anon key ships to the browser, so RLS is
// the only thing standing between a visitor and the data; moving reads onto
// Prisma would move authorisation back into app code, where one forgotten
// `where` clause is a data leak.
//
// There is deliberately no Prisma Client and no generator block. The two server
// paths that legitimately bypass RLS — the M-Pesa callback and profile creation
// at sign-in — already use `createServiceClient()` in lib/supabase/server.ts.
// A second RLS-bypassing data layer would be one more place to audit for no gain.
//
// Field names are snake_case rather than Prisma's camelCase convention, so a row
// looks identical whether it came from here or from supabase-js. One shape to
// remember instead of two, and `lib/supabase/types.ts` stays a direct mirror.
//
// What Prisma cannot express, and therefore lives as raw SQL appended to the
// initial migration: CHECK constraints, partial indexes, functions, triggers,
// RLS policies, and the storage buckets.
// ============================================================================

datasource db {
  provider = "postgresql"
}

// Connection URLs live in prisma.config.ts — Prisma 7 no longer accepts `url`
// or `directUrl` here.

// ── Enums ───────────────────────────────────────────────────────────────────

enum user_role {
  customer
  admin
}

/// The union of EzyBite's status strings and Kelmon's original OrderStatus.
/// Fulfilment only — payment state is tracked separately, so an order can be
/// delivered + unpaid (cash on delivery not yet collected).
enum order_status {
  pending
  awaiting_mpesa
  confirmed
  packed
  delivered
  cancelled
}

enum payment_status {
  unpaid
  initiated
  paid
  failed
}

enum payment_method {
  mpesa
  cod
}

enum order_source {
  storefront
  admin_direct
}

// ── Models ──────────────────────────────────────────────────────────────────

/// One row per Firebase user. `id` IS the Firebase UID — a 28-character string,
/// not a uuid — and there is no auth.users row behind it. Created by
/// app/api/auth/session/route.ts on first sign-in.
///
/// `role` and `loyalty_points` are not client-writable; the
/// guard_profile_columns() trigger raises if a client changes either.
model Profile {
  id             String    @id
  email          String?
  full_name      String?
  phone          String?
  campus         String?
  avatar_url     String?
  role           user_role @default(customer)
  /// Admins with this set can manage accounts. Service-role writes only;
  /// the owner (lib/auth/protected-accounts.ts) always has it.
  super_admin    Boolean   @default(false)
  loyalty_points Int       @default(0)
  /// Kenyan county and the customer's area/estate/hostel. `campus` is their school (optional).
  county         String?
  location       String?
  /// When the customer accepted the Terms of Service and Privacy Policy, and
  /// which version (the policies' effective date, see lib/legal.ts).
  terms_accepted_at DateTime? @db.Timestamptz(6)
  terms_version     String?
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)

  orders  Order[]
  reviews Review[]
  likes   ProductLike[]
  weekly_bonuses LoyaltyWeeklyBonus[]

  @@map("profiles")
}

/// `id` is a slug rather than a uuid so product URLs read well
/// (/product/lv-speedy-bag).
///
/// `rating` and `review_count` are cached aggregates maintained by the
/// sync_product_rating() trigger. Never write them by hand.
model Product {
  id             String   @id
  /// Permanent product code (P001, B001…), assigned by the database from the
  /// category's letter in code_prefixes. Never changed or reused.
  code           String?
  /// 'men' | 'women' | 'unisex' — who the product is for.
  gender         String   @default("unisex")
  name           String
  description    String?
  price          Decimal  @db.Decimal(10, 2)
  original_price Decimal? @db.Decimal(10, 2)
  category       String
  images         String[] @default([])
  sizes          String[] @default([])
  colors         String[] @default([])
  /// Colour name → photo URL, e.g. {"Black": "https://…"}. Optional per colour.
  color_images   Json     @default("{}")
  stock          Int      @default(0)
  rating         Decimal  @default(0) @db.Decimal(2, 1)
  review_count   Int      @default(0)
  /// 'New' | 'Hot' | 'Sale' | null
  badge          String?
  /// false hides it from the storefront without deleting it
  active         Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)

  order_items OrderItem[]
  reviews     Review[]
  homepage_drops HomepageDrop[]
  likes       ProductLike[]

  @@map("products")
}

/// A customer liking a product (the heart on the product page). The raw
/// signal for recommendations.
model ProductLike {
  user_id    String
  product_id String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user    Profile @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@id([user_id, product_id])
  @@index([product_id], map: "product_likes_product_idx")
  @@index([user_id, created_at(sort: Desc)], map: "product_likes_user_created_idx")
  @@map("product_likes")
}

/// `products.category` stays free text; this table is the list admins pick from
/// and decides which categories appear as filter chips on /shop.
model Category {
  name           String   @id
  show_in_filter Boolean  @default(false)
  sort_order     Int      @default(0)
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@map("categories")
}

/// `id` keeps the human-readable KM-XXXXX format from createOrderId().
///
/// `user_id` is nullable so guest and admin-direct (road sale) orders both work;
/// `source` distinguishes them rather than a sentinel user id.
model Order {
  id             String         @id
  user_id        String?
  customer_name  String
  phone          String
  drop_point     String
  /// County the order is delivered to; drop_point is the exact place.
  county         String?
  campus         String?
  notes          String?
  payment_method payment_method @default(mpesa)
  subtotal       Decimal        @db.Decimal(10, 2)
  delivery_fee   Decimal        @default(0) @db.Decimal(10, 2)
  total          Decimal        @db.Decimal(10, 2)
  status         order_status   @default(pending)
  payment_status payment_status @default(unpaid)
  source         order_source   @default(storefront)

  /// Carries a unique partial index — the callback looks an order up by this,
  /// so a duplicate could mark the wrong order paid.
  mpesa_checkout_request_id String?
  mpesa_merchant_request_id String?
  mpesa_receipt_number      String?
  mpesa_result_desc         String?
  /// Safaricom ResultCode from the last callback (0 = paid).
  mpesa_result_code         Int?
  /// When the live STK prompt was sent; claimed atomically so a second
  /// prompt can't be sent while one is still open (double-charge guard).
  mpesa_requested_at        DateTime? @db.Timestamptz(6)
  /// Normalised to 2547…
  mpesa_phone               String?

  /// Idempotency flag for award_loyalty_points().
  points_awarded Boolean @default(false)
  points_earned  Int     @default(0)

  /// Flipped by the orders_deduct_stock trigger when the order becomes paid,
  /// so stock comes off exactly once. Never written by app code.
  stock_deducted Boolean @default(false)

  /// Set by the orders_set_paid_at trigger when the order becomes paid.
  paid_at DateTime? @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  user             Profile?         @relation(fields: [user_id], references: [id], onDelete: SetNull)
  order_items      OrderItem[]
  payment_failures PaymentFailure[]
  mpesa_requests   MpesaRequest[]
  weekly_bonuses   LoyaltyWeeklyBonus[]

  @@index([user_id, created_at(sort: Desc)], map: "orders_user_created_idx")
  @@index([created_at(sort: Desc)], map: "orders_created_idx")
  @@index([status], map: "orders_status_idx")
  @@index([payment_status], map: "orders_payment_status_idx")
  @@map("orders")
}

/// Line details are copied, not referenced: an order must stay an accurate
/// receipt after the product is renamed, repriced or deleted.
model OrderItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id   String
  product_id String?
  name       String
  price      Decimal  @db.Decimal(10, 2)
  quantity   Int
  /// Size or colour chosen at checkout.
  variant    String?
  image      String?
  category   String?

  order   Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@index([order_id], map: "order_items_order_idx")
  @@map("order_items")
}

/// `author_name` is stored so a review keeps its byline after the account behind
/// it is deleted. A unique partial index allows one review per user per product.
model Review {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?
  product_id  String?
  author_name String
  rating      Int
  body        String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  user    Profile? @relation(fields: [user_id], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id, created_at(sort: Desc)], map: "reviews_product_idx")
  @@index([created_at(sort: Desc)], map: "reviews_created_idx")
  @@map("reviews")
}

/// Content table: public read, admin write.
model Deal {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  description      String?
  image            String?
  code             String?
  discount_percent Int?
  starts_at        DateTime? @db.Timestamptz(6)
  ends_at          DateTime? @db.Timestamptz(6)
  active           Boolean   @default(true)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Desc)], map: "deals_created_idx")
  @@map("deals")
}

/// Content table: public read, admin write.
model Update {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String
  body       String
  tag        String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Desc)], map: "updates_created_idx")
  @@map("updates")
}

/// Cards shown in the editable homepage carousel. Kept separate from products
/// so campaign imagery and copy never change the store catalogue.
model HomepageDrop {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  price      Decimal  @db.Decimal(10, 2)
  category   String
  image      String
  active     Boolean  @default(true)
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  /// When set, the card shows this product's live details and opens its page.
  product_id String?

  product Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@index([active, sort_order], map: "homepage_drops_active_sort_idx")
  @@index([product_id], map: "homepage_drops_product_idx")
  @@map("homepage_drops")
}

/// One row per failed M-Pesa attempt, written by the callback with the service
/// role. The order row only keeps the latest result, so this is the history.
model PaymentFailure {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id            String?
  checkout_request_id String?
  result_code         Int?
  result_desc         String?
  /// Customer-facing explanation, e.g. "Wrong M-Pesa PIN entered."
  reason              String
  phone               String?
  amount              Decimal? @db.Decimal(10, 2)
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  order Order? @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([created_at(sort: Desc)], map: "payment_failures_created_idx")
  @@map("payment_failures")
}

/// Admin-editable settings as key/value JSON, e.g. `contact_recipients`
/// (string[] of up to 4 addresses that receive contact-form emails).
model SiteSetting {
  key        String   @id
  value      Json
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("site_settings")
}

/// Every contact-form submission, kept even if the notification email fails.
model ContactMessage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  first_name String
  last_name  String
  email      String
  phone      String?
  message    String
  read       Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Desc)], map: "contact_messages_created_idx")
  @@map("contact_messages")
}

/// Log of emails sent from /admin/communications.
model EmailCampaign {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subject         String
  body            String
  /// 'all_customers' | 'customers_with_orders' | 'custom'
  audience        String
  recipient_count Int      @default(0)
  failed_count    Int      @default(0)
  sent_by         String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Desc)], map: "email_campaigns_created_idx")
  @@map("email_campaigns")
}

/// The admin notification feed. Written by database triggers (new orders,
/// payments, failed payments, low stock, contact messages).
model AdminNotification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 'order' | 'payment' | 'payment_failed' | 'stock' | 'message' | 'system'
  type       String
  title      String
  body       String?
  link       String?
  read       Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Desc)], map: "admin_notifications_created_idx")
  @@map("admin_notifications")
}

/// Every STK prompt sent for an order. The callback resolves orders through
/// this, so paying an older prompt still lands on the right order; a second
/// payment for an already-paid order is kept and flagged `duplicate` for refund.
model MpesaRequest {
  checkout_request_id String   @id
  merchant_request_id String?
  order_id            String
  phone               String?
  amount              Decimal  @db.Decimal(10, 2)
  /// 'pending' | 'paid' | 'failed'
  status              String   @default("pending")
  result_code         Int?
  result_desc         String?
  receipt             String?
  duplicate           Boolean  @default(false)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id, created_at(sort: Desc)], map: "mpesa_requests_order_idx")
  @@map("mpesa_requests")
}

/// One letter per category for product codes (P = Perfumes, B = Bags…).
/// `last_number` is how far the letter has got; only product saves move it.
model CodePrefix {
  letter      String   @id
  /// What the letter stands for, e.g. "Bags".
  name        String
  category    String
  last_number Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@map("code_prefixes")
}

/// Running order number per day (Nairobi time), behind next_order_id().
model OrderDayCounter {
  day         DateTime @id @db.Date
  last_number Int      @default(0)

  @@map("order_day_counters")
}

/// Weekly spend bonus: 5 points the first time a customer's paid orders in a
/// week (Monday–Sunday, Nairobi time) reach KES 1,000. Written only by
/// award_loyalty_points(); admins can read it.
model LoyaltyWeeklyBonus {
  user_id    String
  week_start DateTime @db.Date
  /// The order that tipped the week over KES 1,000.
  order_id   String?
  week_total Decimal  @db.Decimal(10, 2)
  points     Int
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user  Profile @relation(fields: [user_id], references: [id], onDelete: Cascade)
  order Order?  @relation(fields: [order_id], references: [id], onDelete: SetNull)

  @@id([user_id, week_start])
  @@map("loyalty_weekly_bonuses")
}

/// One-time codes for sensitive deletions: emailed to super admins, usable
/// once within 10 minutes, and only for the records stored with the request.
/// Server (service role) only.
model SensitiveActionCode {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action          String
  payload         Json
  summary         String
  code_hash       String
  requested_by    String
  requester_email String?
  attempts        Int       @default(0)
  expires_at      DateTime  @db.Timestamptz(6)
  used_at         DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([requested_by, created_at(sort: Desc)], map: "sensitive_action_codes_requester_idx")
  @@map("sensitive_action_codes")
}
