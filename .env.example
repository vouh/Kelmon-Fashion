# ─────────────────────────────────────────────────────────────────────────────
# Kelmon Fashion — environment
# Copy to .env.local and fill in. Never commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings -> API in the Supabase dashboard.
# The anon key is public (it ships to the browser); RLS is what protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — bypasses RLS. Server-only, never prefix with NEXT_PUBLIC_.
# Used by the M-Pesa callback to mark orders paid with no user session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Google sign-in ──────────────────────────────────────────────────────────
# No env vars needed. Configure in the Supabase dashboard:
#   1. Authentication -> Providers -> Google: paste your Google OAuth client
#      ID and secret (console.cloud.google.com -> Credentials).
#   2. In Google Cloud, set the authorised redirect URI to:
#        https://<your-project>.supabase.co/auth/v1/callback
#   3. Authentication -> URL Configuration -> Redirect URLs, add:
#        http://localhost:3000/auth/callback
#        https://<your-domain>/auth/callback

# ── Email (Resend) ──────────────────────────────────────────────────────────
# resend.com -> API Keys. The from address must be on a domain verified in Resend.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Kelmon <no-reply@your-domain.com>
# Where contact form messages go. Comma-separate multiple addresses.
RESEND_CONTACT_TO_EMAIL=you@example.com

# Public URL of the site, no trailing slash. Password reset links point here.
# Required in production; in development links use the local dev server instead.
NEXT_PUBLIC_SITE_URL=https://kelmon.co.ke

# ── Firebase Admin ──────────────────────────────────────────────────────────
# Firebase console -> Project settings -> Service accounts -> Generate new key.
# Needed to verify sign-ins and to generate password reset links.
# Either paste the whole JSON (raw or base64) here...
FIREBASE_SERVICE_ACCOUNT_JSON=
# ...or set the three fields separately (FIREBASE_ADMIN_* names also work).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── M-Pesa (Daraja) ─────────────────────────────────────────────────────────
# 'sandbox' (default) or 'production'.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret

# Head-office / store short code. Used for the STK password.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-passkey

# Set ONLY if collecting on a till (Buy Goods). Leave blank for Paybill.
# When set, PartyB becomes the till and TransactionType becomes
# CustomerBuyGoodsOnline.
MPESA_TILL_NUMBER=

# Must be a public HTTPS URL Safaricom can reach. Use ngrok in development.
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback

# Shown on the customer's M-Pesa statement. Max 12 characters.
MPESA_ACCOUNT_REFERENCE=Kelmon
