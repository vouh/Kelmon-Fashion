{
  "name": "kelmon-fashion",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "description": "Kelmon — campus fashion and beauty platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:status": "prisma migrate status",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:new": "prisma migrate dev --create-only",
    "db:validate": "prisma validate",
    "db:ddl": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "next": "^15.1.6",
    "papaparse": "^5.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "read-excel-file": "^9.3.10",
    "resend": "^6.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.4.49",
    "prisma": "7.10.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "^5.10.0"
    }
  }
}
