# ── Environment / Secrets ──────────────────────────────────────────────────
# Ignore every .env variant (.env, .env.local, .env.production …) but keep the
# committed template. The previous patterns (.env / *.env) matched neither
# ".env.local" nor ".env.production", which is where the service-role key lives.
.env
.env.*
!.env.example

# Service-account / key files
*service-account*.json
serviceAccount*.json

# ── Dependencies & Build ───────────────────────────────────────────────────
node_modules/
.next/
out/
dist/
build/
next-env.d.ts
*.tsbuildinfo

# ── Deployment ─────────────────────────────────────────────────────────────
.vercel

# ── Supabase CLI ───────────────────────────────────────────────────────────
# Local stack state. Migrations and seed.sql ARE tracked.
supabase/.branches/
supabase/.temp/
supabase/logs/

# ── OS & Editor ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log

# ── Project-specific ignores ──────────────────────────────────────────────
backup_code.html
screen.png
